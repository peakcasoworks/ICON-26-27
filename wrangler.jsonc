// Cloudflare Workers static-assets deploy. `npm run build` writes dist/,
// then `npx wrangler deploy` uploads it. No Worker script: assets only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "icon-26-27",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
